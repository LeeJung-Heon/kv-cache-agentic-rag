OPENAI_API_KEY=
TAVILY_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Local FAISS index
FAISS_INDEX_DIR=artifacts/faiss
PREPROCESSED_CHUNKS=database/chunks.jsonl
DOCUMENT_MANIFEST=database/manifest.json
# needs_review=true인 청크는 기본적으로 원본 확인 전까지 검색에서 제외합니다.
INCLUDE_REVIEW_CHUNKS=false
EMBEDDING_MODEL=BAAI/bge-m3
# Optional: pin a model revision; the resolved revision is saved in manifest.json.
# EMBEDDING_REVISION=
# Optional: assert the model output dimension (BGE-M3 dense: 1024).
# EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=8

RETRIEVAL_TOP_K=5

# Optional: OpenAI-compatible endpoint, local embedding device, Korean TTF font
# OPENAI_BASE_URL=
# EMBEDDING_DEVICE=cpu
# PDF_FONT=/absolute/path/to/korean-font.ttf
