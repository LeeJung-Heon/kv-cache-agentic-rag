OPENAI_API_KEY=
TAVILY_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Local FAISS index
FAISS_INDEX_DIR=.cache/faiss
EMBEDDING_DIMENSION=1024

# Optional: OpenAI-compatible endpoint, local embedding device, Korean TTF font
# OPENAI_BASE_URL=
# EMBEDDING_DEVICE=cpu
# PDF_FONT=/absolute/path/to/korean-font.ttf
