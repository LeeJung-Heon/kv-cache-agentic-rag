OPENAI_API_KEY=
TAVILY_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Database (PostgreSQL + pgvector)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kv_cache
DB_USER=postgres
DB_PASSWORD=postgres
PGVECTOR_DIMENSION=1024

# Optional: OpenAI-compatible endpoint, local embedding device, Korean TTF font
# OPENAI_BASE_URL=
# EMBEDDING_DEVICE=cpu
# PDF_FONT=/absolute/path/to/korean-font.ttf
