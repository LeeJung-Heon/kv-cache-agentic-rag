OPENAI_API_KEY=
TAVILY_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Local FAISS index
FAISS_INDEX_DIR=artifacts/faiss
PROCESSED_MANIFEST=data/processed/documents.json
EMBEDDING_MODEL=BAAI/bge-m3
# Optional: pin a model revision; the resolved revision is saved in manifest.json.
# EMBEDDING_REVISION=
# Optional: assert the model output dimension (BGE-M3 dense: 1024).
# EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=8

# Provisional design defaults: confirm after receiving processed documents.
CHUNK_SIZE=400
CHUNK_OVERLAP=0
CHUNK_INCLUDE_SECTION=true
# Also check the comparison-model tokenizers; [] checks only BGE-M3.
CHUNK_TOKENIZER_MODELS=["intfloat/multilingual-e5-large-instruct","Qwen/Qwen3-Embedding-0.6B"]
RETRIEVAL_TOP_K=5

# Optional: OpenAI-compatible endpoint, local embedding device, Korean TTF font
# OPENAI_BASE_URL=
# EMBEDDING_DEVICE=cpu
# PDF_FONT=/absolute/path/to/korean-font.ttf
